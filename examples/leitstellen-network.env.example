# NUR Netzwerkbeispiel fuer Leitstellen-Verbund, kein Ersatz einer vollstaendigen .env!
# Vorhandene DATA_DIR/GEODATA_DIR und weitere benoetigte Werte unbedingt erhalten.
# Gueltig, wenn Caddy und Spiel dasselbe Host-Netzwerk nutzen:
HOST=127.0.0.1
PORT=7777
PUBLIC_URL=https://gaminglive.mooo.com
ALLOW_HTTP=false
TRUSTED_PROXIES=127.0.0.1,::ffff:127.0.0.1
# Getrennte Container: passend erreichbares Interface/Portmapping und unmittelbare Proxy-IP pruefen.
# Gegebenenfalls benoetigt der Spielcontainer HOST=0.0.0.0; niemals pauschal alle Proxynetze vertrauen.
