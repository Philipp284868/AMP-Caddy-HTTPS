Meta.DisplayName=Caddy HTTPS
Meta.Description=Automatischer HTTPS-Zugang: Domain und Spieladresse direkt in AMP einstellen.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=Unknown
Meta.Author=Philipp284868
Meta.URL=https://github.com/Philipp284868/AMP-Caddy-HTTPS
Meta.DisplayImageSource=internal:UnknownApp
Meta.EndpointURIFormat=
Meta.ConfigManifest=caddy-httpsconfig.json
Meta.MetaConfigManifest=caddy-httpsmetaconfig.json
Meta.ConfigRoot=caddy-https.kvp
Meta.MinAMPVersion=2.8.0.4
Meta.ConfigVersion=2
Meta.ConfigReleaseState=NotSpecified
Meta.AppConfigId=86d14da2-f12a-4ce7-b05d-1bccffbd4950
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=Bash, coreutils, util-linux und tar benoetigt. Instanz und Zertifikatsspeicher persistent einbinden.
Meta.ExtraContainerPackages=[]
Meta.Prerequisites=[]
Meta.NoCommercialUsage=False
Meta.ReleaseNotes=AMP-Einstellungen; validierte automatische Konfiguration; gepruefter Download; vorhandene Zertifikate bleiben erhalten. Vorlage der bestehenden Instanz vor Anwendung-Update aktualisieren.
App.DisplayName=Caddy HTTPS
App.RootDir=./caddy-https/
App.BaseDirectory=./caddy-https/serverfiles/
App.ExecutableLinux=/bin/bash
App.ExecutableWin=
App.WorkingDir=serverfiles
App.CommandLineArgs="{{$FullBaseDir}}amp-caddy.sh" run
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.AppSettings={}
App.EnvironmentVariables={"CADDY_DOMAIN":"{{Domain}}","CADDY_UPSTREAM":"{{Upstream}}","CADDY_MODE":"{{Mode}}","CADDY_ACME_EMAIL":"{{AcmeEmail}}","CADDY_STORAGE_DIRECTORY":"{{StorageDirectory}}","CADDY_HTTP_PORT":"{{$HttpPort}}","CADDY_HTTPS_PORT":"{{$HttpsPort}}","CADDY_BIND_ADDRESS":"{{$ApplicationIPBinding}}"}
App.ExitMethod=SIGTERM
App.ExitTimeout=30
App.HasReadableConsole=True
App.HasWriteableConsole=False
App.AdminMethod=STDIO
App.UseLinuxIOREDIR=False
App.StripANSIControlCodes=True
App.ApplicationIPBinding=0.0.0.0
App.ForceIPBinding=False
App.SupportsIPv6=False
App.Ports=@IncludeJson[caddy-httpsports.json]
App.PrimaryApplicationPortRef=HttpsPort
App.UpdateSources=@IncludeJson[caddy-httpsupdates.json]
App.PreStartStages=[]
App.ApplicationReadyMode=RegexMatch
App.RapidStartup=False
App.Compatibility=None
App.SupportsUniversalSleep=False
App.UseSteamQueryForStatus=False
App.SupportsLiveSettingsChanges=False
App.MonitorChildProcessName=
App.StoresSupported=None
App.StoreSpecificSettings={}
App.StoreDownloadLocations={}
App.SmartExcludeSupported=True
App.SmartExcludeExemptions=["Caddyfile","private/**","*.kvp","*.json","*.conf"]
Console.AppReadyRegex=^.*serving initial configuration.*$
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.HideFromConsoleRegex=
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
